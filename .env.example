POSTGRES_PASSWORD=troque_por_uma_senha_local_forte

# Opcional: se preenchida, tem prioridade sobre as configuracoes padrao.
# Exemplo: postgresql://hackathon:SENHA@localhost:5432/hackathon
DATABASE_URL=

# Acesso ao InHire
INHIRE_ACCESS_PASSWORD=troque_por_uma_senha_de_acesso
INHIRE_SESSION_SECRET=troque_por_uma_chave_aleatoria_de_pelo_menos_32_caracteres
